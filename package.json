{
  "name": "codex-halo",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["apps/desktop"],
  "scripts": {
    "dev": "npm run dev --workspace apps/desktop",
    "build": "npm run build --workspace apps/desktop",
    "release:exe": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1",
    "release:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1 -Bundle",
    "test": "npm run test --workspace apps/desktop",
    "tauri": "npm run tauri --workspace apps/desktop"
  },
  "engines": { "node": ">=20" }
}
