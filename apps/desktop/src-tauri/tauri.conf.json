{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodexHalo",
  "version": "0.1.0",
  "identifier": "com.codexhalo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    },
    "windows": [{
      "label": "main",
      "title": "CodexHalo",
      "width": 352,
      "height": 92,
      "minWidth": 88,
      "minHeight": 88,
      "decorations": false,
      "transparent": true,
      "alwaysOnTop": true,
      "resizable": false,
      "skipTaskbar": true,
      "shadow": false,
      "center": true,
      "visible": true
    }]
  },
  "bundle": { "active": false }
}

